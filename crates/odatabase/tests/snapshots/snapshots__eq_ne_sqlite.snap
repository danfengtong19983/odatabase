---
source: crates/odatabase/tests/snapshots.rs
expression: "sql(&m, Dialect::Sqlite, path, query)"
---
SELECT "t1"."partner_id" AS "c0", "t1"."code" AS "c1", "t1"."label" AS "c2" FROM "partner_role" AS "t1" WHERE ("t1"."label" = 'a' AND "t1"."label" IS NOT NULL) OR ("t1"."label" <> 'b' OR "t1"."label" IS NULL) ORDER BY "t1"."partner_id" ASC, "t1"."code" ASC
