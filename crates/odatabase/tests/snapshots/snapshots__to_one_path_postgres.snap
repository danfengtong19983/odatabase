---
source: crates/odatabase/tests/snapshots.rs
expression: "sql(&m, Dialect::Postgres, path, query)"
---
SELECT "t1"."partner_id" AS "c0", "t1"."code" AS "c1", "t1"."label" AS "c2" FROM "partner_role" AS "t1" WHERE EXISTS(SELECT 1 FROM "business_partner" AS "t2" WHERE "t1"."partner_id" = "t2"."id" AND "t2"."name" = 'x') ORDER BY "t1"."partner_id" ASC, "t1"."code" ASC
